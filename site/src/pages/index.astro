---
import { getCollection } from 'astro:content';
import StatusStrip from '../components/StatusStrip.astro';
import SteppeSignal from '../components/SteppeSignal.astro';
import TagList from '../components/TagList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const writing = (await getCollection('writing', ({ data }) => !data.draft))[0];
const lab = (await getCollection('lab', ({ data }) => !data.draft))[0];
const project = (await getCollection('projects', ({ data }) => !data.draft))[0];
---

<BaseLayout>
  <section class="shell hero">
    <div class="hero-copy">
      <div>
        <div class="coordinate-line"><span>Personal field station</span></div>
        <h1 class="hero-title">Systems for<span class="editorial">real work.</span></h1>
        <p class="intro">
          Здесь я собираю мысли, проекты и эксперименты о том, как инструменты меняют способ думать и работать. Сейчас я строю личную рабочую среду вокруг <strong>AI-агентов, терминала, заметок и автоматизации</strong> — и пишу о том, что действительно помогает, а что только создаёт шум.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#published"><span>See published work</span><span>↓</span></a>
          <a class="button" href="/about/"><span>About me</span><span>→</span></a>
        </div>
      </div>

      <div class="start-here" aria-label="Recommended pages">
        <a class="start-item" href="/projects/memory-wiki/"><small>RU · Project</small><strong>Memory Wiki: карта истории Hermes</strong><em>Active</em></a>
        <a class="start-item" href="/lab/unicode-spinner-playground/"><small>RU · Lab</small><strong>От Unicode spinner к Rose Curve</strong><em>Complete</em></a>
        <a class="start-item" href="/writing/rn-tmuxp-workspaces/"><small>RU · Guide</small><strong>rn: проектные tmux-workspaces одной командой</strong><em>Published</em></a>
      </div>
    </div>

    <SteppeSignal />
  </section>

  <StatusStrip />

  <section class="content-section" id="published">
    <div class="shell section-grid">
      <div class="section-intro">
        <div class="section-kicker">01 / Published</div>
        <h2>From the field</h2>
        <p>Три законченных материала вместо обещаний о будущих публикациях: практическое руководство, локальный инструмент и визуальный эксперимент.</p>
      </div>
      <div class="published-list">
        {writing && (
          <a class="published-row" href={`/writing/${writing.id}/`}>
            <small>Writing · {writing.data.kind}</small>
            <div><h3>{writing.data.title}</h3><p>{writing.data.description}</p><TagList tags={writing.data.tags} /></div>
            <span>Read →</span>
          </a>
        )}
        {project && (
          <a class="published-row" href={`/projects/${project.id}/`}>
            <small>Project · {project.data.status}</small>
            <div><h3>{project.data.title}</h3><p>{project.data.description}</p><TagList tags={project.data.tags} /></div>
            <span>Open →</span>
          </a>
        )}
        {lab && (
          <a class="published-row" href={`/lab/${lab.id}/`}>
            <small>Lab · {lab.data.status}</small>
            <div><h3>{lab.data.title}</h3><p>{lab.data.description}</p><TagList tags={lab.data.tags} /></div>
            <span>Explore →</span>
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="content-section work-section">
    <div class="shell section-grid">
      <div class="section-intro">
        <div class="section-kicker">02 / What I work on</div>
        <h2>Current directions</h2>
        <p>Не список навыков, а три направления, которые уже проявились в реальной работе и опубликованных материалах.</p>
      </div>
      <div class="work-grid">
        <a class="work-card" href="/projects/memory-wiki/">
          <span>01 / Human-readable memory</span>
          <h3>Agent memory that stays inspectable.</h3>
          <p>Локальные инструменты, которые помогают вернуться к прошлой работе без превращения истории в непрозрачную базу знаний.</p>
          <strong>Memory Wiki →</strong>
        </a>
        <a class="work-card" href="/writing/rn-tmuxp-workspaces/">
          <span>02 / Working environments</span>
          <h3>Small systems around real workflows.</h3>
          <p>Терминал, tmux, launchers и coding agents как одна практичная среда — без лишнего слоя управления.</p>
          <strong>Read the rn guide →</strong>
        </a>
        <a class="work-card" href="/lab/unicode-spinner-playground/">
          <span>03 / Interface experiments</span>
          <h3>Motion with a reason to exist.</h3>
          <p>Маленькие визуальные эксперименты, где математика, SVG и interaction detail проверяются в работающем интерфейсе.</p>
          <strong>Open the experiment →</strong>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
